      "parameters": {
        "fromEmail": "info@youragency.com",
        "toEmail": "={{ $json.email }}",
        "subject": "={{ $json.firstName }}, Here's How Much You Could Save on {{ $json.insuranceType }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; background: white; }\n    .content { padding: 40px 30px; }\n    .savings-box { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 30px; text-align: center; border-radius: 10px; margin: 20px 0; }\n    .big-number { font-size: 48px; font-weight: bold; }\n    .comparison { background: #f9f9f9; padding: 20px; border-radius: 5px; margin: 15px 0; }\n    .cta-button { background: #667eea; color: white; padding: 15px 40px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 20px 0; font-weight: bold; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"content\">\n      <h2>Hi {{ $json.firstName }},</h2>\n      \n      <p>I wanted to share something interesting with you...</p>\n      \n      <div class=\"savings-box\">\n        <div>Most {{ $json.state }} residents overpay for {{ $json.insuranceType }} by</div>\n        <div class=\"big-number\">${{\n          $json.insuranceType.toLowerCase().includes('life') ? '847' : \n          $json.insuranceType.toLowerCase().includes('health') ? '1,234' : \n          '650'\n        }}</div>\n        <div>per year</div>\n      </div>\n      \n      <p><strong>Here's why:</strong></p>\n      <div class=\"comparison\">\n        ❌ Most people compare only 2-3 insurance companies<br>\n        ✅ We compare 20+ carriers to find you the absolute best rate\n      </div>\n      \n      <div class=\"comparison\">\n        ❌ Online quotes often miss discounts you qualify for<br>\n        ✅ We know all the insider discounts and how to stack them\n      </div>\n      \n      <div class=\"comparison\">\n        ❌ DIY research takes hours and is confusing<br>\n        ✅ We do all the work in about 10 minutes\n      </div>\n      \n      <p><strong>Want to see what you qualify for?</strong></p>\n      \n      <a href=\"https://calendly.com/youragency/consultation\" class=\"cta-button\">Yes, Show Me My Savings →</a>\n      \n      <p>Or call/text me directly: <strong>(123) 456-7890</strong></p>\n      \n      <p>Talk soon!</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
