    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { \"status\": \"success\", \"message\": \"Appointment confirmed - reminders activated\", \"appointmentId\": $json.appointmentId } }}"
      },
      "id": "webhook-response",
      "name": "Confirm Receipt",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [450, 400]
    },
    {
      "parameters": {
        "jsCode": "// Parse and standardize appointment data\nconst data = $input.first().json;\n\n// Handle different date formats\nlet appointmentDate;\nif (data.body?.appointmentDate) {\n  appointmentDate = new Date(data.body.appointmentDate);\n} else if (data.body?.scheduled_event?.start_time) {\n  appointmentDate = new Date(data.body.scheduled_event.start_time);\n} else {\n  throw new Error('No appointment date provided');\n}\n\nconst now = new Date();\nconst hoursUntilAppointment = (appointmentDate - now) / (1000 * 60 * 60);\n\nreturn {\n  json: {\n    appointmentId: data.body.appointmentId || data.body.event_id || `APT-${Date.now()}`,\n    leadId: data.body.leadId || data.body.invitee_uuid,\n    firstName: data.body.firstName || data.body.name?.split(' ')[0] || '',\n    lastName: data.body.lastName || data.body.name?.split(' ').slice(1).join(' ') || '',\n    email: data.body.email || '',\n    phone: data.body.phone || data.body.phoneNumber || '',\n    appointmentDate: appointmentDate.toISOString(),\n    appointmentTime: appointmentDate.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit', timeZone: 'America/New_York' }),\n    appointmentDay: appointmentDate.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric', year: 'numeric' }),\n    agentName: data.body.agentName || 'Your Insurance Agent',\n    agentEmail: data.body.agentEmail || 'agent@youragency.com',\n    agentPhone: data.body.agentPhone || '(123) 456-7890',\n    insuranceType: data.body.insuranceType || 'insurance',\n    meetingType: data.body.meetingType || 'phone_call',\n    meetingLink: data.body.meetingLink || '',\n    timezone: data.body.timezone || 'America/New_York',\n    hoursUntilAppointment: Math.round(hoursUntilAppointment * 10) / 10,\n    scheduledAt: now.toISOString(),\n    status: 'scheduled',\n    remindersSent: []\n  }\n};"
      },
      "id": "parse-appointment",
      "name": "Parse Appointment Data",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 400],
      "notes": "Standardizes data from different calendar sources"
    },
    {
      "parameters": {
        "authentication": "oAuth2",
        "sendTo": "={{ $json.email }}",
        "subject": "✅ Appointment Confirmed with {{ $json.agentName }}",
        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif; line-height: 1.6; color: #333; margin: 0; padding: 0; }\n    .container { max-width: 600px; margin: 0 auto; background: white; }\n    .header { background: linear-gradient(135deg, #28a745 0%, #20c997 100%); color: white; padding: 40px 30px; text-align: center; }\n    .checkmark { font-size: 60px; margin-bottom: 10px; }\n    .content { padding: 40px 30px; }\n    .appointment-box { background: #f8f9fa; padding: 25px; border-left: 4px solid #28a745; margin: 20px 0; border-radius: 5px; }\n    .detail-row { margin: 12px 0; padding: 10px 0; border-bottom: 1px solid #e9ecef; }\n    .label { font-weight: bold; color: #667eea; display: inline-block; width: 140px; }\n    .value { color: #333; }\n    .add-calendar { background: #667eea; color: white; padding: 15px 30px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 20px 0; font-weight: bold; }\n    .reschedule { color: #dc3545; text-decoration: none; }\n    .prep-box { background: #fff3cd; padding: 20px; border-left: 4px solid #ffc107; margin: 20px 0; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <div class=\"checkmark\">✅</div>\n      <h1>You're All Set!</h1>\n      <p>Your appointment is confirmed</p>\n    </div>\n    <div class=\"content\">\n      <h2>Hi {{ $json.firstName }}!</h2>\n      \n      <p>Great news! Your {{ $json.insuranceType }} consultation is confirmed.</p>\n      \n      <div class=\"appointment-box\">\n        <h3 style=\"margin-top: 0; color: #28a745;\">📅 Appointment Details</h3>\n        <div class=\"detail-row\">\n          <span class=\"label\">Date:</span>\n          <span class=\"value\">{{ $json.appointmentDay }}</span>\n        </div>\n        <div class=\"detail-row\">\n          <span class=\"label\">Time:</span>\n          <span class=\"value\">{{ $json.appointmentTime }} ({{ $json.timezone }})</span>\n        </div>\n        <div class=\"detail-row\">\n          <span class=\"label\">With:</span>\n          <span class=\"value\">{{ $json.agentName }}</span>\n        </div>\n        <div class=\"detail-row\">\n          <span class=\"label\">Type:</span>\n          <span class=\"value\">{{ $json.meetingType === 'phone_call' ? 'Phone Call' : $json.meetingType === 'video' ? 'Video Conference' : 'In-Person Meeting' }}</span>\n        </div>\n        {{ $json.meetingType === 'phone_call' ? `\n        <div class=\"detail-row\">\n          <span class=\"label\">We'll call you at:</span>\n          <span class=\"value\">${$json.phone}</span>\n        </div>\n        ` : '' }}\n        {{ $json.meetingLink ? `\n        <div class=\"detail-row\">\n          <span class=\"label\">Meeting Link:</span>\n          <span class=\"value\"><a href=\"${$json.meetingLink}\">${$json.meetingLink}</a></span>\n        </div>\n        ` : '' }}\n      </div>\n      \n      <a href=\"https://calendar.google.com/calendar/render?action=TEMPLATE&text=Insurance+Consultation+with+{{ $json.agentName }}&dates={{ $json.appointmentDate.replace(/[-:]/g, '').replace(/\\.\\d{3}Z/, 'Z') }}&details=Consultation+about+{{ $json.insuranceType }}&location={{ $json.meetingLink || $json.agentPhone }}\" class=\"add-calendar\">📅 Add to Google Calendar</a>\n      \n      <div class=\"prep-box\">\n        <h4 style=\"margin-top: 0;\">🎯 How to Prepare:</h4>\n        <ul>\n          <li>Have your current insurance information handy (if applicable)</li>\n          <li>Know your budget and coverage goals</li>\n          <li>Prepare any questions you have about coverage options</li>\n          <li>Have a pen and paper ready to take notes</li>\n        </ul>\n      </div>\n      \n      <h3>What to Expect:</h3>\n      <p>During our 15-20 minute consultation, we'll:</p>\n      <ol>\n        <li>Review your current situation and coverage needs</li>\n        <li>Compare quotes from 20+ top-rated carriers</li>\n        <li>Explain your options in plain English (no confusing jargon!)</li>\n        <li>Answer all your questions</li>\n        <li>Help you choose the best coverage at the best price</li>\n      </ol>\n      \n      <p><strong>Need to reschedule?</strong> <a href=\"https://youragency.com/reschedule/{{ $json.appointmentId }}\" class=\"reschedule\">Click here to pick a new time</a></p>\n      \n      <p>Looking forward to speaking with you!</p>\n      \n      <p>Best regards,<br>\n      <strong>{{ $json.agentName }}</strong><br>\n      {{ $json.agentPhone }}<br>\n      {{ $json.agentEmail }}</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
      },
