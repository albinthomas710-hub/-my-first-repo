    {
      "parameters": {
        "jsCode": "// Process appointment responses\nconst response = $input.first().json;\nconst action = response.body.action; // 'confirm', 'cancel', 'reschedule'\nconst appointmentId = response.body.appointmentId;\n\nlet status, message, nextAction;\n\nswitch(action) {\n  case 'confirm':\n  case 'YES':\n    status = 'confirmed';\n    message = 'Thank you for confirming! We\\'re looking forward to speaking with you.';\n    nextAction = 'proceed_as_scheduled';\n    break;\n    \n  case 'cancel':\n  case 'CANCEL':\n    status = 'cancelled';\n    message = 'Your appointment has been cancelled. If you\\'d like to reschedule, visit: https://youragency.com/schedule';\n    nextAction = 'notify_agent_cancellation';\n    break;\n    \n  case 'reschedule':\n  case 'CHANGE':\n    status = 'needs_reschedule';\n    message = 'No problem! Click here to pick a new time: https://youragency.com/reschedule/' + appointmentId;\n    nextAction = 'send_reschedule_link';\n    break;\n    \n  default:\n    status = 'unknown_response';\n    message = 'We didn\\'t understand that. Reply YES to confirm, CHANGE to reschedule, or CANCEL to cancel.';\n    nextAction = 'request_clarification';\n}\n\nreturn {\n  json: {\n    appointmentId: appointmentId,\n    action: action,\n    status: status,\n    message: message,\n    nextAction: nextAction,\n    respondedAt: new Date().toISOString()\n  }\n};"
      },
      "id": "process-response",
      "name": "Process Response",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 800],
      "notes": "Handles confirm/cancel/reschedule actions"
    },
