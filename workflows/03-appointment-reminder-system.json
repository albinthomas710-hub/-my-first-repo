{
  "name": "🗓️ Appointment Reminder & Reschedule System",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "appointment-scheduled",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "appointment-trigger",
      "name": "Appointment Scheduled",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1.1,
      "position": [250, 400],
      "webhookId": "appointment-scheduled",
      "notes": "Triggered when appointment is booked via Calendly, GoHighLevel, or manual entry"
