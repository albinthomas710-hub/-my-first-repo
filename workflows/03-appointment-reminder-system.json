        "emailType": "html",
        "message": "=<!DOCTYPE html>\n<html>\n<head>\n  <style>\n    body { font-family: Arial, sans-serif; line-height: 1.6; color: #333; }\n    .container { max-width: 600px; margin: 0 auto; padding: 30px; }\n    .header { background: #667eea; color: white; padding: 30px; text-align: center; border-radius: 10px 10px 0 0; }\n    .content { background: #f9f9f9; padding: 30px; border-radius: 0 0 10px 10px; }\n    .reminder-box { background: white; padding: 20px; border-left: 4px solid #ffc107; margin: 20px 0; }\n    .confirm-btn { background: #28a745; color: white; padding: 15px 40px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 20px 10px; font-weight: bold; }\n    .reschedule-btn { background: #dc3545; color: white; padding: 15px 40px; text-decoration: none; border-radius: 5px; display: inline-block; margin: 20px 10px; font-weight: bold; }\n  </style>\n</head>\n<body>\n  <div class=\"container\">\n    <div class=\"header\">\n      <h1>⏰ Appointment Reminder</h1>\n    </div>\n    <div class=\"content\">\n      <h2>Hi {{ $json.firstName }}!</h2>\n      \n      <p>Just a friendly reminder that you have an appointment <strong>tomorrow</strong>.</p>\n      \n      <div class=\"reminder-box\">\n        <h3 style=\"margin-top: 0;\">📅 Tomorrow's Appointment</h3>\n        <p><strong>Date:</strong> {{ $json.appointmentDay }}</p>\n        <p><strong>Time:</strong> {{ $json.appointmentTime }} ({{ $json.timezone }})</p>\n        <p><strong>With:</strong> {{ $json.agentName }}</p>\n        <p><strong>Topic:</strong> {{ $json.insuranceType }} consultation</p>\n        {{ $json.meetingType === 'phone_call' ? `<p><strong>We'll call:</strong> ${$json.phone}</p>` : '' }}\n        {{ $json.meetingLink ? `<p><strong>Join here:</strong> <a href=\"${$json.meetingLink}\">Click to join meeting</a></p>` : '' }}\n      </div>\n      \n      <p><strong>We're looking forward to helping you find the best {{ $json.insuranceType }} coverage!</strong></p>\n      \n      <div style=\"text-align: center;\">\n        <a href=\"https://youragency.com/confirm/{{ $json.appointmentId }}\" class=\"confirm-btn\">✅ Confirm Appointment</a>\n        <a href=\"https://youragency.com/reschedule/{{ $json.appointmentId }}\" class=\"reschedule-btn\">📅 Reschedule</a>\n      </div>\n      \n      <p style=\"font-size: 12px; color: #666; margin-top: 30px;\">Can't make it? Please let us know ASAP so we can help someone else.</p>\n    </div>\n  </div>\n</body>\n</html>",
        "options": {}
