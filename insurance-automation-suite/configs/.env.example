# ==================================
# INSURANCE AUTOMATION SUITE CONFIG
# ==================================
# Copy this file to .env and fill in your actual values

# ==================================
# CORE AGENT/AGENCY INFORMATION
# ==================================
AGENT_NAME="John Smith"
AGENCY_NAME="Smith Insurance Agency"
AGENT_PHONE="+12345678900"
AGENT_EMAIL="john@smithinsurance.com"
AGENT_BCC_EMAIL="backup@smithinsurance.com"

# ==================================
# n8n CONFIGURATION
# ==================================
N8N_WEBHOOK_BASE_URL="https://your-n8n-instance.com"
N8N_ENCRYPTION_KEY="your-encryption-key-here"

# ==================================
# URLs & LINKS
# ==================================
CALENDAR_BOOKING_LINK="https://calendly.com/your-link"
GOOGLE_REVIEW_LINK="https://g.page/your-business/review"
WEBSITE_URL="https://www.your-agency.com"

# ==================================
# DATABASE (PostgreSQL)
# ==================================
POSTGRES_HOST="your-db-host.com"
POSTGRES_PORT=5432
POSTGRES_DATABASE="insurance_automation"
POSTGRES_USER="your_db_user"
POSTGRES_PASSWORD="your_secure_password"
POSTGRES_SSL=true

# ==================================
# OPENAI API
# ==================================
OPENAI_API_KEY="sk-your-openai-api-key"
OPENAI_MODEL_DEFAULT="gpt-4o-mini"
OPENAI_MODEL_ADVANCED="gpt-4o"

# ==================================
# TWILIO (SMS)
# ==================================
TWILIO_ACCOUNT_SID="your-account-sid"
TWILIO_AUTH_TOKEN="your-auth-token"
TWILIO_PHONE="+12345678900"

# ==================================
# SMTP EMAIL SETTINGS
# ==================================
SMTP_HOST="smtp.gmail.com"
SMTP_PORT=587
SMTP_USER="your-email@gmail.com"
SMTP_PASSWORD="your-app-password"
SMTP_SECURE=false

# ==================================
# SLACK (Optional - Team Notifications)
# ==================================
SLACK_WORKSPACE_ID="T1234567890"
SLACK_OAUTH_TOKEN="xoxb-your-slack-token"
SLACK_CHANNEL_LEADS="C1234567890"
SLACK_CHANNEL_AUTOMATION="C0987654321"
SLACK_CHANNEL_SALES="C1122334455"

# ==================================
# TELEGRAM (Optional - Agent Alerts)
# ==================================
TELEGRAM_BOT_TOKEN="123456:ABC-DEF1234ghIkl-zyx57W2v1u123ew11"
TELEGRAM_AGENT_CHAT_ID="123456789"

# ==================================
# CRM INTEGRATION (GoHighLevel)
# ==================================
GHL_API_KEY="your-gohighlevel-api-key"
GHL_LOCATION_ID="your-location-id"

# Alternative CRMs - uncomment the one you use:
# HUBSPOT_API_KEY="your-hubspot-key"
# SALESFORCE_CLIENT_ID="your-salesforce-client-id"
# SALESFORCE_CLIENT_SECRET="your-salesforce-secret"
# PIPEDRIVE_API_TOKEN="your-pipedrive-token"

# ==================================
# BUSINESS LOGIC SETTINGS
# ==================================

# Referral Program
REFERRAL_INCENTIVE="$25 Amazon gift card for each referral that becomes a client"

# Lead Qualification Thresholds
HOT_LEAD_THRESHOLD=80
WARM_LEAD_THRESHOLD=60
COLD_LEAD_THRESHOLD=40

# Follow-Up Settings
MAX_FOLLOW_UP_ATTEMPTS=7
FOLLOW_UP_INTERVAL_HOURS=24

# Appointment Settings
APPOINTMENT_REMINDER_1_HOURS=24
APPOINTMENT_REMINDER_2_HOURS=4
APPOINTMENT_REMINDER_3_MINUTES=30

# ==================================
# ADVANCED SETTINGS
# ==================================

# Error Handling
ERROR_WORKFLOW_ID=""
ENABLE_ERROR_NOTIFICATIONS=true

# Rate Limiting
OPENAI_MAX_REQUESTS_PER_MINUTE=50
TWILIO_MAX_SMS_PER_HOUR=100

# Data Retention
KEEP_LEAD_DATA_DAYS=730
KEEP_CHAT_LOGS_DAYS=90
KEEP_EXECUTION_LOGS_DAYS=30

# ==================================
# TIMEZONE
# ==================================
TIMEZONE="America/New_York"

# ==================================
# FEATURE FLAGS
# ==================================
ENABLE_AI_QUALIFICATION=true
ENABLE_SMART_FOLLOWUP=true
ENABLE_APPOINTMENT_AUTOMATION=true
ENABLE_REFERRAL_SYSTEM=true
ENABLE_MISSED_CALL_RECOVERY=true
ENABLE_QUOTE_GENERATOR=true
ENABLE_NURTURE_CAMPAIGN=true
ENABLE_CLIENT_ONBOARDING=true
ENABLE_CHAT_BOT=true

# ==================================
# DEVELOPMENT / TESTING
# ==================================
DEBUG_MODE=false
TEST_MODE=false
TEST_PHONE_NUMBER="+19999999999"
TEST_EMAIL="test@example.com"
