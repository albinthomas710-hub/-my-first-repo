        "query": "SELECT \n  a.*,\n  l.first_name,\n  l.last_name,\n  l.email,\n  l.phone,\n  l.qualification_tier,\n  l.qualification_score\nFROM appointments a\nLEFT JOIN leads l ON a.lead_id = l.id\nWHERE \n  a.status IN ('confirmed', 'reminded')\n  AND a.appointment_time < NOW() - INTERVAL '15 minutes'\n  AND a.appointment_time > NOW() - INTERVAL '2 hours'\n  AND a.no_show_recovery_sent = false\nORDER BY a.appointment_time DESC;",
        "options": {}
