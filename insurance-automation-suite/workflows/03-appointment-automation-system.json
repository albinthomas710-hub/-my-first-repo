    {
      "parameters": {
        "content": "Hi {{ $json.first_name }},\n\nI was really looking forward to our call today at {{ DateTime.fromISO($json.appointment_time).toFormat('h:mm a') }}, but I didn't see you join the meeting.\n\nI understand things come up! \n\nI still want to help you get the right coverage and answer any questions you have. Would you like to reschedule?\n\nYou can book a new time here: {{ $env.CALENDAR_BOOKING_LINK }}\n\nOr just reply to this email with a time that works better for you.\n\nLooking forward to connecting!\n\nBest regards,\n{{ $env.AGENT_NAME }}\n{{ $env.AGENT_PHONE }}",
        "fromName": "={{ $env.AGENT_NAME }}",
        "fromEmail": "={{ $env.AGENT_EMAIL }}",
        "toEmail": "={{ $json.email }}",
        "subject": "Missed you today - let's reschedule?",
        "options": {}
      },
      "id": "send-noshow-email",
      "name": "📧 Send No-Show Recovery Email",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [1050, 1120],
      "credentials": {
        "smtp": {
          "id": "{{SMTP_CREDENTIAL_ID}}",
          "name": "SMTP Email"
        }
      }
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE appointments\nSET \n  status = 'no_show',\n  no_show_recovery_sent = true,\n  no_show_recovery_sent_at = NOW(),\n  updated_at = NOW()\nWHERE id = {{ $json.id }};\n\n-- Update lead status\nUPDATE leads\nSET \n  status = 'no_show_recovery',\n  last_no_show_at = NOW(),\n  updated_at = NOW()\nWHERE id = {{ $json.lead_id }};",
        "options": {}
      },
      "id": "mark-noshow-processed",
