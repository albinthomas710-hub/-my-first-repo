      "id": "reminder-schedule",
      "name": "⏰ Check Reminders (Every 2 Hours)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [250, 700]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  a.*,\n  l.first_name,\n  l.last_name,\n  l.qualification_tier,\n  EXTRACT(EPOCH FROM (a.appointment_time - NOW())) / 3600 AS hours_until_appointment\nFROM appointments a\nLEFT JOIN leads l ON a.lead_id = l.id\nWHERE \n  a.status IN ('confirmed', 'reminded')\n  AND a.appointment_time > NOW()\n  AND (\n    -- 24 hour reminder (within 24-26 hours)\n    (a.reminder_1_sent = false AND a.appointment_time BETWEEN NOW() + INTERVAL '24 hours' AND NOW() + INTERVAL '26 hours')\n    \n    -- 4 hour reminder (within 4-6 hours)\n    OR (a.reminder_2_sent = false AND a.appointment_time BETWEEN NOW() + INTERVAL '4 hours' AND NOW() + INTERVAL '6 hours')\n    \n    -- 30 minute reminder (within 30-60 minutes)\n    OR (a.reminder_3_sent = false AND a.appointment_time BETWEEN NOW() + INTERVAL '30 minutes' AND NOW() + INTERVAL '60 minutes')\n  )\nORDER BY a.appointment_time ASC;",
        "options": {}
      },
      "id": "get-appointments-for-reminders",
      "name": "📋 Get Appointments Needing Reminders",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [450, 700],
      "credentials": {
        "postgres": {
          "id": "{{POSTGRES_CREDENTIAL_ID}}",
          "name": "PostgreSQL - CRM Database"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "has-appointments",
              "leftValue": "={{ $json.length }}",
              "rightValue": 0,
              "operator": {
                "type": "number",
                "operation": "gt"
              }
            }
          ]
        }
      },
      "id": "check-has-appointments",
      "name": "❓ Any Reminders to Send?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [650, 700]
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "split",
              "name": "appointment",
              "value": "={{ $json }}",
              "type": "object"
            }
          ]
        },
        "options": {}
      },
      "id": "split-appointments",
      "name": "🔄 Split Appointments",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.4,
      "position": [850, 640]
    },
    {
      "parameters": {
        "jsCode": "const appt = $input.first().json;\nconst hoursUntil = appt.hours_until_appointment;\n\nlet reminderType, reminderNumber;\n\nif (hoursUntil >= 24 && hoursUntil <= 26 && !appt.reminder_1_sent) {\n  reminderType = '24_hour';\n  reminderNumber = 1;\n} else if (hoursUntil >= 4 && hoursUntil <= 6 && !appt.reminder_2_sent) {\n  reminderType = '4_hour';\n  reminderNumber = 2;\n} else if (hoursUntil >= 0.5 && hoursUntil <= 1 && !appt.reminder_3_sent) {\n  reminderType = '30_minute';\n  reminderNumber = 3;\n} else {\n  // Skip this one\n  return null;\n}\n\nconst apptTime = new Date(appt.appointment_time);\nconst firstName = appt.lead_name.split(' ')[0];\n\nconst messages = {\n  '24_hour': {\n    email_subject: `Reminder: Your appointment tomorrow at ${apptTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}`,\n    email_body: `Hi ${firstName},\\n\\nThis is a friendly reminder that you have an appointment scheduled with ${process.env.AGENT_NAME} tomorrow:\\n\\n📅 ${apptTime.toLocaleDateString('en-US', { weekday: 'long', month: 'long', day: 'numeric' })}\\n🕐 ${apptTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}\\n💻 Meeting Link: ${appt.meeting_link}\\n\\nLooking forward to speaking with you!\\n\\nIf you need to reschedule, please let me know ASAP.\\n\\nBest regards,\\n${process.env.AGENT_NAME}`,\n    sms_message: `Hi ${firstName}! Reminder: Your appointment with ${process.env.AGENT_NAME} is tomorrow at ${apptTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}. Link: ${appt.meeting_link}`\n  },\n  '4_hour': {\n    email_subject: `Your appointment is in 4 hours`,\n    email_body: `Hi ${firstName},\\n\\nJust a quick reminder - your appointment is coming up in about 4 hours!\\n\\n🕐 Time: ${apptTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}\\n💻 Meeting Link: ${appt.meeting_link}\\n\\nSee you soon!\\n\\n${process.env.AGENT_NAME}`,\n    sms_message: `Hi ${firstName}! Your appointment is in 4 hours at ${apptTime.toLocaleTimeString('en-US', { hour: 'numeric', minute: '2-digit' })}. Link: ${appt.meeting_link} - See you soon!`\n  },\n  '30_minute': {\n    email_subject: `Starting in 30 minutes!`,\n    email_body: `Hi ${firstName},\\n\\nYour appointment starts in 30 minutes!\\n\\n💻 Join here: ${appt.meeting_link}\\n\\nSee you very soon!\\n${process.env.AGENT_NAME}`,\n    sms_message: `${firstName}, your call starts in 30 min! Join: ${appt.meeting_link}`\n  }\n};\n\nreturn {\n  json: {\n    ...appt,\n    reminder_type: reminderType,\n    reminder_number: reminderNumber,\n    reminder_messages: messages[reminderType],\n    first_name: firstName\n  }\n};"
      },
      "id": "determine-reminder-type",
      "name": "🎯 Determine Reminder Type",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1050, 640]
    },
