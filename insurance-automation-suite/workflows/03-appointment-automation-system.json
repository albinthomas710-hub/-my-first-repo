    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_AGENT_CHAT_ID}}",
        "text": "⚠️ **NO-SHOW ALERT**\n\nLead: {{ $json.first_name }} {{ $json.last_name }}\nScheduled: {{ DateTime.fromISO($json.appointment_time).toFormat('MMM d, h:mm a') }}\nQualification: {{ $json.qualification_tier }} ({{ $json.qualification_score }}/100)\n\nRecovery messages sent automatically.\n\nRecommended: Personal call/voicemail within next 2 hours.",
        "additionalFields": {
          "parseMode": "Markdown"
        }
      },
      "id": "alert-agent-noshow",
      "name": "📢 Alert Agent (High-Value Leads)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1450, 1040],
      "credentials": {
        "telegramApi": {
          "id": "{{TELEGRAM_CREDENTIAL_ID}}",
          "name": "Telegram Bot"
        }
      },
      "filter": {
        "conditions": {
          "options": {
            "caseSensitive": false
          },
          "conditions": [
            {
              "id": "high-value",
              "leftValue": "={{ $json.qualification_score }}",
              "rightValue": 70,
              "operator": {
