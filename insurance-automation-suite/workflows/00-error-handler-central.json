            "Severity": "={{ $json.severity }}",
            "Error": "={{ $json.error_message }}",
            "Suggested_Action": "={{ $json.suggested_action }}",
            "Execution_ID": "={{ $json.execution_id }}",
            "Status": "Open"
          }
        },
        "options": {}
