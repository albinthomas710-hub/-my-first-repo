      "typeVersion": 1.1,
      "position": [1650, 240]
    },
    {
      "parameters": {
        "jsCode": "// Attempt to re-trigger the failed workflow\nconst errorData = $input.first().json;\n\nreturn {\n  json: {\n    message: `Auto-recovery attempted for ${errorData.workflow_name}`,\n    original_error: errorData.error_message,\n    retry_scheduled: true,\n    retry_time: new Date(Date.now() + 300000).toISOString()\n  }\n};"
      },
