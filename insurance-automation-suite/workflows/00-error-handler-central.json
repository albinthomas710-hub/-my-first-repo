{
  "name": "⚠️ Central Error Handler & Monitoring",
  "nodes": [
    {
      "parameters": {},
      "id": "error-trigger",
      "name": "Error Trigger",
      "type": "n8n-nodes-base.errorTrigger",
      "typeVersion": 1,
      "position": [250, 300]
    },
    {
      "parameters": {
        "jsCode": "const error = $input.first().json;\nconst now = new Date();\n\n// Extract error details\nconst errorDetails = {\n  workflow_id: error.workflow?.id || 'unknown',\n  workflow_name: error.workflow?.name || 'Unknown Workflow',\n  execution_id: error.execution?.id || 'unknown',\n  node_name: error.node?.name || 'Unknown Node',\n  node_type: error.node?.type || 'Unknown Type',\n  error_message: error.error?.message || 'No error message',\n  error_stack: error.error?.stack || '',\n  error_timestamp: now.toISOString(),\n  input_data: JSON.stringify(error.inputData || {}),\n  \n  // Categorize error\n  error_category: categorizeError(error.error?.message || ''),\n  severity: determineSeverity(error.workflow?.name, error.error?.message),\n  \n  // Resolution suggestions\n  suggested_action: suggestResolution(error.error?.message || ''),\n  auto_recoverable: isAutoRecoverable(error.error?.message || '')\n};\n\nfunction categorizeError(message) {\n  if (message.includes('ECONNREFUSED') || message.includes('timeout')) return 'CONNECTION';\n  if (message.includes('401') || message.includes('403')) return 'AUTHENTICATION';\n  if (message.includes('429')) return 'RATE_LIMIT';\n  if (message.includes('500') || message.includes('502')) return 'SERVER_ERROR';\n  if (message.includes('Invalid') || message.includes('required')) return 'VALIDATION';\n  return 'UNKNOWN';\n}\n\nfunction determineSeverity(workflowName, message) {\n  // Critical workflows\n  if (workflowName.includes('Lead Qualification') || workflowName.includes('Missed Call')) {\n    return 'CRITICAL';\n  }\n  // High priority\n  if (workflowName.includes('Appointment') || workflowName.includes('Quote')) {\n    return 'HIGH';\n  }\n  // Medium priority\n  if (workflowName.includes('Follow-Up') || workflowName.includes('Referral')) {\n    return 'MEDIUM';\n  }\n  // Low priority\n  return 'LOW';\n}\n\nfunction suggestResolution(message) {\n  if (message.includes('ECONNREFUSED')) return 'Check database/API service status';\n  if (message.includes('401') || message.includes('403')) return 'Verify API credentials';\n  if (message.includes('429')) return 'Reduce request rate or wait before retry';\n  if (message.includes('timeout')) return 'Increase timeout value or check network';\n  if (message.includes('Invalid')) return 'Check input data format';\n  return 'Review error details and workflow configuration';\n}\n\nfunction isAutoRecoverable(message) {\n  const recoverableErrors = ['ECONNREFUSED', 'timeout', '429', '500', '502', '503'];\n  return recoverableErrors.some(err => message.includes(err));\n}\n\nreturn { json: errorDetails };"
      },
      "id": "analyze-error",
      "name": "🔍 Analyze Error",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [450, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "table": "error_logs",
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "workflow_id": "={{ $json.workflow_id }}",
            "workflow_name": "={{ $json.workflow_name }}",
            "execution_id": "={{ $json.execution_id }}",
            "node_name": "={{ $json.node_name }}",
            "node_type": "={{ $json.node_type }}",
            "error_message": "={{ $json.error_message }}",
            "error_stack": "={{ $json.error_stack }}",
            "error_category": "={{ $json.error_category }}",
            "severity": "={{ $json.severity }}",
            "suggested_action": "={{ $json.suggested_action }}",
            "auto_recoverable": "={{ $json.auto_recoverable }}",
            "input_data": "={{ $json.input_data }}",
            "resolved": false,
            "created_at": "={{ $json.error_timestamp }}"
          }
        }
      },
      "id": "log-to-database",
      "name": "💾 Log to Database",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.5,
      "position": [650, 300],
      "credentials": {
        "postgres": {
          "id": "{{POSTGRES_CREDENTIAL_ID}}",
          "name": "PostgreSQL - CRM Database"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "is-critical",
              "leftValue": "={{ $json.severity }}",
              "rightValue": "CRITICAL,HIGH",
              "operator": {
                "type": "string",
                "operation": "includes"
              }
            }
          ]
        }
      },
      "id": "check-severity",
      "name": "🚨 Critical/High Priority?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2,
      "position": [850, 300]
    },
    {
      "parameters": {
        "operation": "sendMessage",
        "chatId": "={{$env.TELEGRAM_AGENT_CHAT_ID}}",
        "text": "🚨 **CRITICAL ERROR ALERT**\n\n**Workflow**: {{ $json.workflow_name }}\n**Node**: {{ $json.node_name }}\n**Category**: {{ $json.error_category }}\n**Severity**: {{ $json.severity }}\n\n**Error**: {{ $json.error_message }}\n\n**Suggested Action**: {{ $json.suggested_action }}\n\n**Execution ID**: {{ $json.execution_id }}\n**Time**: {{ DateTime.fromISO($json.error_timestamp).toFormat('MMM d, h:mm a') }}",
        "additionalFields": {
          "parseMode": "Markdown"
        }
      },
      "id": "alert-telegram-critical",
      "name": "📱 Alert via Telegram (Critical)",
      "type": "n8n-nodes-base.telegram",
      "typeVersion": 1.2,
      "position": [1050, 200],
      "credentials": {
        "telegramApi": {
          "id": "{{TELEGRAM_CREDENTIAL_ID}}",
          "name": "Telegram Bot"
        }
      }
    },
    {
      "parameters": {
        "content": "🚨 Critical Error in Insurance Automation\n\nWorkflow: {{ $json.workflow_name }}\nNode: {{ $json.node_name }}\nError Category: {{ $json.error_category }}\nSeverity: {{ $json.severity }}\n\nError Message:\n{{ $json.error_message }}\n\nSuggested Action:\n{{ $json.suggested_action }}\n\nExecution ID: {{ $json.execution_id }}\nTimestamp: {{ $json.error_timestamp }}\n\nPlease investigate and resolve ASAP.\n\nn8n Dashboard: {{ $env.N8N_WEBHOOK_BASE_URL }}/executions",
        "fromName": "n8n Error Monitor",
        "fromEmail": "={{ $env.AGENT_EMAIL }}",
        "toEmail": "={{ $env.AGENT_EMAIL }}",
        "subject": "🚨 CRITICAL ERROR: {{ $json.workflow_name }}",
        "options": {}
      },
