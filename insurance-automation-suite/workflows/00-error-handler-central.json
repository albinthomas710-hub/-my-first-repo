    {
      "parameters": {
        "conditions": {
          "options": {},
          "conditions": [
            {
              "id": "is-recoverable",
              "leftValue": "={{ $json.auto_recoverable }}",
              "rightValue": true,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
