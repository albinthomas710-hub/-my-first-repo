            "client_id": "={{ $json.id }}",
            "review_request_scheduled_for": "={{ $json.review_request_scheduled_for }}",
            "referral_request_scheduled_for": "={{ $json.referral_request_scheduled_for }}",
            "review_request_sent": false,
            "referral_request_sent": false,
            "review_submitted": false,
            "referrals_received": 0,
            "created_at": "={{ $now.toISO() }}"
          }
        }
      },
