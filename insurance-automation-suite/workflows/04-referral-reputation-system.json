        "messages": {
          "values": [
            {
              "role": "system",
              "content": "You are an expert at crafting warm, authentic review and referral requests for insurance agents.\n\nCreate a personalized message that:\n- Feels genuine and appreciative, not transactional\n- Makes it EASY to leave a review (direct links, clear steps)\n- Uses social proof and reciprocity\n- Short and mobile-friendly\n\nProvide response in JSON:\n{\n  \"email_subject\": \"subject line\",\n  \"email_body\": \"email content with review links\",\n  \"sms_message\": \"SMS version\"\n}"
            },
            {
              "role": "user",
              "content": "Create a Google review request for:\n\nClient: {{ $json.first_name }} {{ $json.last_name }}\nCoverage: {{ $json.coverage_type }}\nPolicy Start: {{ $json.policy_start_date }}\n\nAgent: {{ $env.AGENT_NAME }}\nAgency: {{ $env.AGENCY_NAME }}\nGoogle Review Link: {{ $env.GOOGLE_REVIEW_LINK }}\n\nTone: Warm, grateful, make it feel like they're helping you grow your business to help more families."
            }
          ]
        },
        "options": {
          "temperature": 0.8,
          "maxTokens": 500
        },
        "jsonOutput": true
      },
      "id": "generate-review-request",
      "name": "✍️ AI Review Request Generator",
      "type": "@n8n/n8n-nodes-langchain.openAi",
      "typeVersion": 1.5,
      "position": [1250, 520],
      "credentials": {
        "openAiApi": {
          "id": "{{OPENAI_CREDENTIAL_ID}}",
          "name": "OpenAI API"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const client = $input.first().json;\nconst aiResponse = $input.last().json;\n\nlet messages;\ntry {\n  const content = aiResponse.choices[0].message.content;\n  messages = typeof content === 'string' ? JSON.parse(content) : content;\n} catch (e) {\n  // Fallback\n  messages = {\n    email_subject: `Quick favor? 🌟`,\n    email_body: `Hi ${client.first_name},\\n\\nI hope you're happy with your new ${client.coverage_type} coverage!\\n\\nIf you have 60 seconds, I'd be incredibly grateful if you could leave a quick Google review. It helps me help more families like yours get the protection they need.\\n\\nLeave a review here: ${process.env.GOOGLE_REVIEW_LINK}\\n\\nThank you so much!\\n\\n${process.env.AGENT_NAME}`,\n    sms_message: `Hi ${client.first_name}! Quick favor - if you're happy with your ${client.coverage_type} coverage, could you leave a Google review? Takes 30 sec: ${process.env.GOOGLE_REVIEW_LINK} Thanks! - ${process.env.AGENT_NAME}`\n  };\n}\n\nreturn {\n  json: {\n    ...client,\n    review_messages: messages\n  }\n};"
      },
