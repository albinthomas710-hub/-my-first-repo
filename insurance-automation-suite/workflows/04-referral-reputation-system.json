    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT \n  rc.*,\n  c.first_name,\n  c.last_name,\n  c.email,\n  c.phone,\n  c.annual_premium,\n  c.policy_number,\n  c.coverage_type,\n  c.policy_start_date\nFROM referral_campaigns rc\nJOIN clients c ON rc.client_id = c.id\nWHERE \n  (\n    -- Review requests due\n    (rc.review_request_sent = false \n     AND rc.review_request_scheduled_for <= NOW())\n    \n    -- Referral requests due\n    OR (rc.referral_request_sent = false \n        AND rc.referral_request_scheduled_for <= NOW())\n  )\nORDER BY c.annual_premium DESC\nLIMIT 30;",
        "options": {}
      },
