    {
      "parameters": {
        "jsCode": "const client = $input.first().json;\nconst now = new Date();\n\n// Calculate optimal timing for referral request\n// Best time: 3-7 days after policy issued (when excitement is still high)\nconst requestDate = new Date(now);\nrequestDate.setDate(requestDate.getDate() + 5); // 5 days delay\n\n// Review request timing: immediately after positive interaction\nconst reviewRequestDate = new Date(now);\nreviewRequestDate.setHours(reviewRequestDate.getHours() + 2); // 2 hours delay\n\nreturn {\n  json: {\n    ...client,\n    referral_request_scheduled_for: requestDate.toISOString(),\n    review_request_scheduled_for: reviewRequestDate.toISOString(),\n    first_name: client.first_name,\n    policy_value: client.annual_premium || 0,\n    is_high_value: (client.annual_premium || 0) > 2000\n  }\n};"
      },
      "id": "calculate-timing",
      "name": "⏰ Calculate Optimal Timing",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [650, 300]
    },
    {
      "parameters": {
        "operation": "create",
        "table": "referral_campaigns",
